#!/usr/bin/env python3
"""API key 登录：读一行 key，写进 ~/.qwen/.env（0600），并让 qwen-code 启动时选 OpenAI 兼容认证。
密钥不进日志、不进 settings.json；qwen-code 读不到环境变量里的 OPENAI_API_KEY 时会自己读 .env。
网关没接时用它；端点和模型来自 compose 的环境变量（阿里云百炼的 OpenAI 兼容接口）。"""
import sys
from pathlib import Path

sys.path.insert(0, "/usr/local/lib/wonton-agent")
import qwen_settings  # noqa: E402

ENV_FILE = Path.home() / ".qwen" / ".env"
ENV_KEY = "OPENAI_API_KEY"


def store_key(key: str) -> None:
    lines = []
    if ENV_FILE.exists():
        lines = [line for line in ENV_FILE.read_text().splitlines()
                 if not line.startswith(f"{ENV_KEY}=")]
    lines.append(f"{ENV_KEY}={key}")
    ENV_FILE.parent.mkdir(parents=True, exist_ok=True)
    ENV_FILE.write_text("\n".join(lines) + "\n")
    ENV_FILE.chmod(0o600)


def main() -> None:
    key = "".join(sys.stdin.readline().split())
    if not key:
        sys.exit("没读到 key")
    store_key(key)
    data = qwen_settings.load()
    if qwen_settings.at(data, "security", "auth", "selectedType") != "openai":
        qwen_settings.ensure(data, "security", "auth")["selectedType"] = "openai"
        qwen_settings.save(data)
    if not key.startswith("sk-"):
        print("key 不是 sk- 开头，还是存下了，不对就重来一次")
    print("API key 已保存，Agent 正在重启")


if __name__ == "__main__":
    main()
