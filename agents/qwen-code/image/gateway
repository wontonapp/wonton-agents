#!/usr/bin/env python3
"""Pin Qwen Code's configured primary and helper models to magpie.

Only the gateway provider is advertised; keys remain in the process environment.
"""
import os
import sys

sys.path.insert(0, "/usr/local/lib/wonton-agent")
import qwen_settings as qs  # noqa: E402


def ensure_common(data: dict) -> None:
    """跟网关无关的两项：MCP 只放行 Wonton（桥在 session/new 里把它叫 wonton），关自动更新。"""
    mcp = qs.ensure(data, "mcp")
    allowed = mcp.setdefault("allowed", ["wonton"])
    if isinstance(allowed, list) and "wonton" not in allowed:
        allowed.append("wonton")
    general = qs.ensure(data, "general")
    general["enableAutoUpdate"] = False


def clear() -> None:
    sys.exit("magpie 模型网关未就绪：Qwen Code 只支持网关模型，不能清除网关配置")


def write() -> None:
    base = os.environ["WONTON_MODEL_BASE_URL"].strip()
    model = os.environ["WONTON_MODEL_DEFAULT"].strip()
    data = qs.load()
    ensure_common(data)
    data["modelProviders"] = {"openai": [{
        "id": model,
        "name": "magpie",
        "baseUrl": base,
        "envKey": "OPENAI_API_KEY",
        "description": "magpie 模型网关",
    }]}
    data["providerProtocol"] = {}
    auth = qs.ensure(data, "security", "auth")
    auth["selectedType"] = "openai"
    auth["enforcedType"] = "openai"
    auth["useExternal"] = False
    auth.pop("apiKey", None)
    auth["baseUrl"] = base
    selected = qs.ensure(data, "model")
    selected["name"] = model
    selected["baseUrl"] = base
    for role in ("fastModel", "visionModel", "compactionModel"):
        data[role] = model
    for role in ("advisorModel", "imageModel", "voiceModel"):
        data[role] = model if data.get(role) else ""
    qs.ensure(data, "tools", "webSearch")["enabled"] = False
    data["batch"] = {"model": model, "authType": "openai", "baseUrl": base}
    data["modelFallbacks"] = ""
    qs.save(data)
    print(f"网关配置已写进 ~/.qwen/settings.json：{base}，模型 {model}")


if __name__ == "__main__":
    action = sys.argv[1] if len(sys.argv) > 1 else ""
    if action == "apply":
        write()
    elif action == "clear":
        clear()
    else:
        sys.exit(f"用法：{sys.argv[0]} apply|clear")
