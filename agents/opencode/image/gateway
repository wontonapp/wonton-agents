#!/usr/bin/env python3
"""Manage magpie model defaults and provider policy without restoring direct routes.

The key is an environment reference, never a value in the configuration file.
"""
import json
import os
import sys
from pathlib import Path

CONFIG = Path(os.path.expanduser("~/.config/opencode/opencode.json"))
PROVIDER_ID = "magpie"


def apply() -> None:
    base = os.environ["WONTON_MODEL_BASE_URL"].strip()
    model = os.environ["WONTON_MODEL_DEFAULT"].strip()
    config = {
        "$schema": "https://opencode.ai/config.json",
        # opencode 的 model 引用是 provider/model 两段，模型 id 里的斜杠不碍事（实测 2.2.7）。
        "model": f"{PROVIDER_ID}/{model}",
        "agents": {
            name: {"model": f"{PROVIDER_ID}/{model}"}
            for name in ("build", "plan", "general", "explore", "title", "summary", "compaction")
        },
        # Upstream policies are last-match-wins and also apply to saved accounts.
        "policies": [
            {"action": "provider.use", "resource": "*", "effect": "deny"},
            {"action": "provider.use", "resource": PROVIDER_ID, "effect": "allow"},
            {"action": "integration.connect", "resource": "*", "effect": "deny"},
        ],
        "providers": {
            PROVIDER_ID: {
                "name": "magpie",
                "env": ["WONTON_MODEL_API_KEY"],
                "package": "@opencode/ai/providers/openai-compatible",
                "settings": {"baseURL": base},
                "models": {model: {"name": model}},
            },
        },
        # 只放行 Wonton MCP（桥按会话传进来的服务器），其余工具照 opencode 缺省一律先问：
        # MCP 工具的权限动作是「服务器名_工具名」，wonton_ 前缀一条就盖住（* 也吃下划线）。
        # opencode 内置 agent 缺省放开一切（实测 2.2.7：Agent.Info 的缺省 ruleset 是 allow-all），
        # 改文件和跑命令显式收紧成先问，桥才转得成主人的确认卡片。
        "permissions": [
            {"action": "wonton_*", "resource": "*", "effect": "allow"},
            {"action": "edit", "resource": "*", "effect": "ask"},
            {"action": "shell", "resource": "*", "effect": "ask"},
        ],
    }
    CONFIG.parent.mkdir(parents=True, exist_ok=True)
    CONFIG.write_text(json.dumps(config, indent=2) + "\n")
    print(f"网关配置已写进 {CONFIG}：{base}，模型 {model}")


def clear() -> None:
    sys.exit("magpie 模型网关未就绪：OpenCode 只支持网关模型，不能清除网关配置")


if __name__ == "__main__":
    action = sys.argv[1] if len(sys.argv) > 1 else ""
    if action == "apply":
        apply()
    elif action == "clear":
        clear()
    else:
        sys.exit(f"用法：{sys.argv[0]} apply|clear")
