#!/usr/bin/env python3
"""OpenCode 账号登录：官方 `opencode auth login` 的密钥输入要真终端（实测 2.2.7 在管道上报
"API key input requires an interactive terminal"），这里起一个 pty 跑官方命令，把底座登录通道
转发进来的一行 key 写进 pty，其余输出原样回传（底座会剥配色码）。回显关掉，密钥不出现在输出里；
官方命令要连 opencode 的服务端校验，超过 240 秒就中止并如实报错。"""
import fcntl
import os
import pty
import select
import struct
import sys
import termios
import time

CMD_TEMPLATE = ["{opencode}", "auth", "login", "opencode", "--method", "key"]
PROMPT = "API key"
READY_TIMEOUT = 60
TOTAL_TIMEOUT = 240


def main() -> int:
    if len(sys.argv) != 2:
        sys.exit(f"用法：{sys.argv[0]} <opencode 二进制路径>")
    cmd = [part.format(opencode=sys.argv[1]) for part in CMD_TEMPLATE]
    line = sys.stdin.readline()
    if not line.strip():
        sys.exit("没收到 key：应把 API key 作为一行发进来")
    payload = (line.strip() + "\n").encode()

    pid, master = pty.fork()
    if pid == 0:
        os.environ.setdefault("NO_BROWSER", "1")
        os.execvp(cmd[0], cmd)
    attrs = termios.tcgetattr(master)
    attrs[3] &= ~termios.ECHO
    termios.tcsetattr(master, termios.TCSANOW, attrs)
    fcntl.ioctl(master, termios.TIOCSWINSZ, struct.pack("HHHH", 40, 120, 0, 0))

    sent = False
    seen = b""
    started = time.monotonic()
    while True:
        if time.monotonic() - started > TOTAL_TIMEOUT:
            os.write(master, b"\x03")
            time.sleep(1)
            try:
                os.kill(pid, 9)
            except ProcessLookupError:
                pass
            sys.exit("opencode auth login 超时，已中止")
        ready, _, _ = select.select([master], [], [], 1.0)
        if master not in ready:
            continue
        try:
            data = os.read(master, 4096)
        except OSError:
            break
        if not data:
            break
        sys.stdout.buffer.write(data)
        sys.stdout.buffer.flush()
        if not sent:
            seen = (seen + data)[-4096:]
            if PROMPT in seen.decode("utf-8", "replace"):
                time.sleep(0.3)
                os.write(master, payload)
                sent = True
    _, status = os.waitpid(pid, 0)
    return os.waitstatus_to_exitcode(status)


if __name__ == "__main__":
    sys.exit(main())
