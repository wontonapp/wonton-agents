#!/usr/bin/env python3
"""Manage omp model routes without restoring old custom providers or API keys."""
import json
import os
import sys
from pathlib import Path

CONFIG_DIR = Path(os.environ.get("HOME", "/data/agent/home")) / ".omp" / "agent"
PROVIDER = "litellm"
ROLES = ("default", "smol", "slow", "plan", "vision", "commit", "tiny", "memory", "task", "advisor")
# Pinned omp 18.16.0 auth catalog. enabledProviders is NOT a transport allowlist.
BUILTIN_PROVIDERS = frozenset("""
abliteration aiand aimlapi alibaba-coding-plan alibaba-token-plan amazon-bedrock
anthropic apple azure baseten bedrock-mantle cerebras charm-hyper cline-pass
cloudflare-ai-gateway cloudflare-workers-ai commandcode coralbricks coreweave
cursor deepinfra deepseek devin exa factory-droid firepass fireworks github-copilot
gitlab-duo gitlab-duo-agent gmi-cloud google google-antigravity google-gemini-cli
google-vertex groq helmcode huggingface inception kagi kilo kimi-code litellm
llama.cpp lm-studio local meta minimax minimax-code minimax-code-cn mistral modular
moonshot muse-code nanogpt novita nvidia ollama ollama-cloud openai openai-codex
openai-codex-device opencode-go opencode-zen openrouter parallel perplexity qianfan
qwen-portal sakana sambanova scaleway siliconflow siliconflow-cn singularityapi-dev
singularityapi-tech snowflake stencil stepfun synthetic tavily together typesafe
umans venice vercel-ai-gateway vllm wafer-serverless web xai xai-oauth xiaomi
xiaomi-token-plan-ams xiaomi-token-plan-cn xiaomi-token-plan-sgp yolo-auto zai
zai-coding-plan zenmux zhipu-coding-plan
""".split())
SUBSCRIPTIONS = {
    "openai-codex-device": "openai-codex",
    "github-copilot": "github-copilot",
    "kimi-code": "kimi-code",
    "gitlab-duo-agent": "gitlab-duo-agent",
    "factory-droid": "factory-droid",
    "muse-code": "muse-code",
    "xai-oauth": "xai-oauth",
    "cursor": "cursor",
    "perplexity": "perplexity",
}


def write_settings(provider: str, roles: dict) -> None:
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    settings = {
        "modelRoles": roles,
        "enabledModels": [roles["default"]] if roles else [],
        "disabledProviders": sorted((BUILTIN_PROVIDERS | {"wonton", PROVIDER}) - {provider}),
        "modelProviderOrder": [provider],
    }
    (CONFIG_DIR / "config.yml").write_text(json.dumps(settings))


def apply() -> None:
    required = ("WONTON_MODEL_DEFAULT", "WONTON_MODEL_BASE_URL", "WONTON_MODEL_API_KEY")
    if not all(os.environ.get(name, "").strip() for name in required):
        raise ValueError("magpie 模型网关未就绪：缺少模型配置")
    model = os.environ["WONTON_MODEL_DEFAULT"]
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    provider = {
        "baseUrl": os.environ["WONTON_MODEL_BASE_URL"],
        "api": "openai-completions",
        "apiKey": "LITELLM_API_KEY",
        "models": [{"id": model}],
    }
    (CONFIG_DIR / "models.yml").write_text(json.dumps({"providers": {PROVIDER: provider}}))
    selector = f"{PROVIDER}/{model}"
    write_settings(PROVIDER, {role: selector for role in ROLES})


def clear() -> None:
    if os.environ.get("WONTON_AGENT_MODEL_SOURCE") != "official":
        raise ValueError("只有显式选择官方订阅后才能清除 magpie 配置")
    method = os.environ.get("WONTON_AGENT_LOGIN_ID", "")
    provider = SUBSCRIPTIONS.get(method)
    if provider is None:
        raise ValueError("未选择受支持的官方订阅登录方式")
    # Do not restore custom models/keys. Successful upstream OAuth login has
    # already stored the subscription in agent.db; that store is left intact.
    (CONFIG_DIR / "models.yml").unlink(missing_ok=True)
    write_settings(provider, {})


def main() -> None:
    if len(sys.argv) != 2 or sys.argv[1] not in ("apply", "clear"):
        print(f"用法：{sys.argv[0]} apply|clear", file=sys.stderr)
        sys.exit(2)
    (apply if sys.argv[1] == "apply" else clear)()


if __name__ == "__main__":
    main()
