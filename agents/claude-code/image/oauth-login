#!/usr/bin/env python3
"""清除外部 API 设置，再运行 CLI 的 Claude 订阅 OAuth 登录。"""
import os
import sys

sys.path.insert(0, "/usr/local/lib/wonton-agent")
import agent_settings  # noqa: E402

ADAPTER = "/data/agent/tools/claude-agent-acp/0.101.0/dist/index.js"


def drop_api_key() -> None:
    data = agent_settings.load()
    agent_settings.remove_model_routes(data)
    agent_settings.save(data)


def main() -> None:
    if sys.argv[1:] != ["claudeai"]:
        sys.exit("用法：oauth-login claudeai")
    drop_api_key()
    agent_settings.clean_process_env()
    sys.stdout.flush()
    os.execvp("node", ["node", ADAPTER, "--cli", "auth", "login", "--claudeai"])


if __name__ == "__main__":
    main()
