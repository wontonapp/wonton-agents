#!/usr/bin/env python3
"""模型网关配置；只有明确选择官方订阅时才清除，不恢复旧 API 配置。"""
import os
import sys

sys.path.insert(0, "/usr/local/lib/wonton-agent")
import agent_settings  # noqa: E402



def clear() -> None:
    if os.environ.get("WONTON_AGENT_MODEL_SOURCE") != "official":
        sys.exit("模型网关未就绪：只有明确选择官方订阅后才能清除网关配置")
    data = agent_settings.load()
    agent_settings.remove_model_routes(data)
    agent_settings.save(data)
    print("已选择 Claude 官方订阅；订阅凭据保留，不恢复外部 API 设置")


def write() -> None:
    selected_env = agent_settings.gateway_env()
    data = agent_settings.load()
    agent_settings.remove_model_routes(data)
    env = agent_settings.env_of(data)
    env.update(selected_env)
    model = selected_env["ANTHROPIC_MODEL"]
    data["model"] = model
    data["availableModels"] = [model]
    agent_settings.save(data)
    print("已选择 magpie 模型网关")


if __name__ == "__main__":
    action = sys.argv[1] if len(sys.argv) > 1 else ""
    if action == "apply":
        write()
    elif action == "clear":
        clear()
    else:
        sys.exit(f"用法：{sys.argv[0]} apply|clear")
