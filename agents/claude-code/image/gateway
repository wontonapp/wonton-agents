#!/usr/bin/env python3
"""网关钩子：apply 把网关写进 Claude Code 的用户设置 env，clear 逐键还原。

只讲 Anthropic Messages：WONTON_MODEL_ANTHROPIC_BASE_URL 为空时按没接网关处理（清掉）。
Claude Code 的设置 env 不做 ${变量} 展开（实测 2.1.318 会把字面量发出去），所以密钥只能写值；
设置文件 0600。
clear 只动 apply 写过的那几个键，用户的 OAuth 凭据（~/.claude/.credentials.json）不碰。
"""
import os
import sys

sys.path.insert(0, "/usr/local/lib/wonton-agent")
import agent_settings  # noqa: E402

# 写进设置 env 的键；网关地址、凭据、模型之外，把 haiku 别名也指到同一个模型，
# 免得后台的小任务去请求网关里不存在的模型。
MANAGED = {
    "ANTHROPIC_BASE_URL": "WONTON_MODEL_ANTHROPIC_BASE_URL",
    "ANTHROPIC_AUTH_TOKEN": "WONTON_MODEL_API_KEY",
    "ANTHROPIC_MODEL": None,
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": None,
}


def clear() -> None:
    backup = agent_settings.read_backup()
    if backup is None:
        return
    data = agent_settings.load()
    env = agent_settings.env_of(data)
    for key, previous in backup.items():
        if previous is None:
            env.pop(key, None)
        else:
            env[key] = previous
    agent_settings.save(data)
    agent_settings.BACKUP.unlink(missing_ok=True)
    print("网关配置已从 ~/.claude/settings.json 移除")


def write() -> None:
    base = os.environ["WONTON_MODEL_ANTHROPIC_BASE_URL"].strip()
    model = os.environ["WONTON_MODEL_DEFAULT"].strip()
    # 上次 apply 的备份还在就沿用，别把网关自己的值当用户的值再备份一遍。
    if agent_settings.read_backup() is None:
        current = agent_settings.env_of(agent_settings.load())
        agent_settings.write_backup({key: current.get(key) for key in MANAGED})
    data = agent_settings.load()
    env = agent_settings.env_of(data)
    for key, source in MANAGED.items():
        env[key] = model if source is None else os.environ[source].strip()
    agent_settings.save(data)
    print(f"网关配置已写进 ~/.claude/settings.json：{base}，模型 {model}")


if __name__ == "__main__":
    action = sys.argv[1] if len(sys.argv) > 1 else ""
    if action == "apply" and os.environ.get("WONTON_MODEL_ANTHROPIC_BASE_URL", "").strip():
        write()
    elif action in ("apply", "clear"):
        clear()
    else:
        sys.exit(f"用法：{sys.argv[0]} apply|clear")
