#!/usr/bin/env python3
"""ChatGPT 订阅状态不把保存的 API key 算成已登录。"""
import json
import os
from pathlib import Path

home = Path(os.environ.get("CODEX_HOME") or Path.home() / ".codex")
try:
    auth = json.loads((home / "auth.json").read_text())
except (OSError, ValueError):
    raise SystemExit(1)
raise SystemExit(0 if auth.get("tokens") and auth.get("auth_mode") != "apikey" else 1)
