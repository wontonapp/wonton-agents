#!/usr/bin/env python3
"""网关钩子：底座带全部环境变量调它。apply 把模型网关写进 ~/.kimi-code/config.toml
（default_model + providers.wonton + models.wonton/default），clear 移出去。
密钥不落盘：providers.wonton 只写 apiKeyEnv，值留在环境变量里；不改 User-Agent。"""
import sys

sys.path.insert(0, "/usr/local/lib/wonton-agent")
import kimi_config

if len(sys.argv) != 2 or sys.argv[1] not in ("apply", "clear"):
    print(f"用法：{sys.argv[0]} apply|clear", file=sys.stderr)
    sys.exit(2)
if sys.argv[1] == "apply":
    kimi_config.gateway_apply()
else:
    kimi_config.gateway_clear()
