#!/usr/bin/env python3
"""网关钩子：默认和子代理模型指向 magpie；官方模式保留订阅，不恢复平台 key。"""
import sys

sys.path.insert(0, "/usr/local/lib/wonton-agent")
import kimi_config

if len(sys.argv) != 2 or sys.argv[1] not in ("apply", "clear"):
    print(f"用法：{sys.argv[0]} apply|clear", file=sys.stderr)
    sys.exit(2)
if sys.argv[1] == "apply":
    kimi_config.gateway_apply()
else:
    kimi_config.gateway_clear()
