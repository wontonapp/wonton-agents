#!/usr/bin/env python3
"""设备码订阅登录状态；凭据不决定模型来源。"""
import json
import sys

sys.path.insert(0, "/usr/local/lib/wonton-agent")
import kimi_config

method = sys.argv[1] if len(sys.argv) > 1 else ""
kimi_home = kimi_config.home()

if method == "kimi-account":
    provider = kimi_config.load().get("providers", {}).get(kimi_config.NATIVE_PROVIDER, {})
    key = provider.get("oauth", {}).get("key", "oauth/kimi-code")
    name = key.removeprefix("oauth/")
    if not name or "/" in name or name.startswith("."):
        sys.exit(1)
    token = kimi_home / "credentials" / f"{name}.json"
    try:
        credentials = json.loads(token.read_text(encoding="utf-8"))
        sys.exit(0 if credentials.get("access_token") and credentials.get("refresh_token") else 1)
    except (OSError, ValueError, AttributeError):
        sys.exit(1)
print(f"未知的登录方式 {method}", file=sys.stderr)
sys.exit(2)
