#!/usr/bin/env python3
"""Launch Kimi ACP without inherited external model/provider overrides."""
import os
import sys

for key in list(os.environ):
    if key.startswith("KIMI_MODEL_") or key in ("KIMI_API_KEY", "KIMI_BASE_URL"):
        del os.environ[key]
os.execv("/data/agent/tools/kimi/2.5.3/dist/main.mjs",
         ["kimi", "acp", *sys.argv[1:]])
