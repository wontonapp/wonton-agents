#!/usr/bin/env python3
"""dsh 的网关钩子：apply 把模型网关写进 acp profile 的补丁
（$DSH_HOME/profiles/acp/cordis.patch.yml，普通 YAML 数组，整文件重写）：

- acp 段固定 ACP 会话的默认模型到网关（pi-ai 自定义 provider，OpenAI 兼容）；
- llm-pi-ai 段声明 wonton-gateway provider：密钥只引用变量名（apiKeyEnv），值留在环境变量里；
- session-log-deepseek 段关掉会话日志插件：官方路由默认随请求回传会话日志（dsh_session_log），
  会话日志不能发给网关。

clear 删掉网关段、保留关会话日志：没接网关时 dsh 走官方路由加用户自己的 key
（登录网页或 /wonton login 写进凭据文件），会话日志默认也关，官方路由收不到。
补丁文件由本钩子维护：apply 覆盖、clear 重写，手工改动不保留。
"""
import os
import sys
from pathlib import Path

dsh_home = Path(os.environ.get("DSH_HOME") or Path.home() / ".dsh")
patch = dsh_home / "profiles" / "acp" / "cordis.patch.yml"

SESSION_LOG_OFF = """- id: session-log-deepseek
  config:
    enabled: false
"""

if len(sys.argv) != 2 or sys.argv[1] not in ("apply", "clear"):
    print(f"用法：{sys.argv[0]} apply|clear", file=sys.stderr)
    sys.exit(2)

patch.parent.mkdir(parents=True, exist_ok=True)
if sys.argv[1] == "clear":
    patch.write_text(
        "# 由 Wonton 模型网关钩子维护：apply 覆盖整个文件，clear 保留关会话日志。\n"
        + SESSION_LOG_OFF
    )
    sys.exit(0)

base_url = os.environ["WONTON_MODEL_BASE_URL"]
model = os.environ["WONTON_MODEL_DEFAULT"]
for name, value in (("WONTON_MODEL_BASE_URL", base_url), ("WONTON_MODEL_DEFAULT", model)):
    if not value or "\r" in value or "\n" in value:
        print(f"{name} 为空或含换行，写不出合法的补丁", file=sys.stderr)
        sys.exit(1)

patch.write_text(f"""\
# 由 Wonton 模型网关钩子维护：apply 覆盖整个文件，clear 保留关会话日志。
- id: acp
  config:
    provider: wonton-gateway
    model: {model}
- id: llm-pi-ai
  config:
    providers:
      wonton-gateway:
        apiKeyEnv: WONTON_MODEL_API_KEY
        api: openai-completions
        baseURL: {base_url}
        models:
          - id: {model}
""" + SESSION_LOG_OFF)
