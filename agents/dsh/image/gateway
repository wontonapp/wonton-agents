#!/usr/bin/env python3
"""Keep dsh's ACP and shared model defaults on magpie; never restore direct routes."""
import json
import os
import sys
from pathlib import Path

dsh_home = Path(os.environ.get("DSH_HOME") or Path.home() / ".dsh")
patch = dsh_home / "profiles" / "acp" / "cordis.patch.yml"

SESSION_LOG_OFF = """- id: session-log-deepseek
  config:
    enabled: false
"""

if len(sys.argv) != 2 or sys.argv[1] not in ("apply", "clear"):
    print(f"用法：{sys.argv[0]} apply|clear", file=sys.stderr)
    sys.exit(2)

if sys.argv[1] == "clear":
    sys.exit("magpie 模型网关未就绪：dsh 只支持网关模型，不能清除网关配置")

base_url = os.environ.get("WONTON_MODEL_BASE_URL", "")
model = os.environ.get("WONTON_MODEL_DEFAULT", "")
api_key = os.environ.get("WONTON_MODEL_API_KEY", "")
for name, value in (("WONTON_MODEL_BASE_URL", base_url), ("WONTON_MODEL_DEFAULT", model),
                    ("WONTON_MODEL_API_KEY", api_key)):
    if not value or "\r" in value or "\n" in value:
        print(f"{name} 为空或含换行，写不出合法的补丁", file=sys.stderr)
        sys.exit(1)

patch.parent.mkdir(parents=True, exist_ok=True)
base_url = json.dumps(base_url)
model = json.dumps(model)
patch.write_text(f"""\
# 由 magpie 模型网关钩子维护；不恢复外部凭据或路由。
- id: acp
  config:
    provider: magpie
    model: {model}
- id: agent-default-model
  config:
    provider: magpie
    model: {model}
- id: llm-deepseek
  disabled: true
- id: llm-deepseek-account
  disabled: true
- id: settings
  disabled: true
- id: web-search-deepseek
  disabled: true
- id: web-deepseek-api
  disabled: true
- id: llm-pi-ai
  config:
    providers:
      magpie:
        apiKeyEnv: WONTON_MODEL_API_KEY
        api: openai-completions
        baseURL: {base_url}
        models:
          - id: {model}
""" + SESSION_LOG_OFF)
