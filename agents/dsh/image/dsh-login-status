#!/usr/bin/env python3
"""dsh 的登录状态（[[login]] status）：凭据文件里 refs 有非空的 DEEPSEEK_API_KEY 就算已登录。
退出码 0 = 已登录，非 0 = 没登录；登录网页的列表显示用。"""
import os
import re
import sys
from pathlib import Path

dsh_home = Path(os.environ.get("DSH_HOME") or Path.home() / ".dsh")
try:
    text = (dsh_home / ".credentials.yaml").read_text()
except OSError:
    sys.exit(1)
sys.exit(0 if re.search(r"(?m)^\s+DEEPSEEK_API_KEY:\s*\S", text) else 1)
